#!/usr/bin/env bash
# Developer shell for the fixed Apple Silicon ROS 2 Jazzy runtime.
# Runtime launches should use scripts/so101-macos.zsh.

ros_root=/opt/ros/jazzy

export VIRTUAL_ENV="$ros_root/.venv"
unset PYTHONHOME PYTHONPATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH
unset DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH DYLD_INSERT_LIBRARIES
export PATH="$VIRTUAL_ENV/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PYTHONNOUSERSITE=1
export TMPDIR=/tmp
export TMP=/tmp
export TEMP=/tmp
export ROS_HOME=/opt/data/so101/ros-home
export ROS_LOG_DIR=/opt/data/so101/ros-logs
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"

for setup in \
  "$ros_root/install/setup.bash" \
  "$ros_root/extra_ws/install/setup.bash" \
  "/opt/data/so101/runtime/fork/current/local_setup.bash" \
  "/opt/data/so101/workspace/install/local_setup.bash"; do
  if [[ ! -f "$setup" ]]; then
    log_error "missing fixed SO-101 setup: $setup; run scripts/so101-macos.zsh prepare"
    return 1
  fi
  watch_file "$setup"
  source_env "$setup"
done

dylib_farm="$ros_root/dylib_farm/current"
if [[ ! -d "$dylib_farm" ]]; then
  log_error "missing fixed SO-101 dylib farm: $dylib_farm; run scripts/so101-macos.zsh prepare"
  return 1
fi
export DYLD_LIBRARY_PATH="$dylib_farm"
