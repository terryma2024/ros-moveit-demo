<mujoco model="scene">
  <include file="panda.mjcf"/>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.9 0.9 0.9"
      width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.6 0.45 0.3 1"/>
    <material name="coke_mat" rgba="0.8 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <!--
      Coordinate convention: panda_link0 is the world origin (its base sits on
      the table top at z = 0). This mirrors the Gazebo world's world_to_panda
      offset (0 0 0.775) with the table top at z = 0.775, simply re-centered so
      that panda_link0 == world origin == the perception node's TF target frame.

      Everything below is expressed relative to that origin, matching the
      Gazebo world exactly (identical camera/coke/panda relative geometry).
    -->
    <geom name="floor" type="plane" size="3 3 0.05" pos="0 0 -0.775" material="floor_mat"/>

    <!-- Table: static slab 1.2 x 0.8 x 0.05, top surface at z = 0. -->
    <body name="table" pos="0 0 -0.025">
      <geom name="table_top" type="box" size="0.6 0.4 0.025" material="table_mat" friction="1 0.1 0.1"/>
    </body>

    <!-- Coke can: cylinder r=0.033, length=0.122, resting on the table top.
         Center at z = 0.061 (half-length). -->
    <body name="coke" pos="0.3 0 0.061">
      <freejoint/>
      <inertial mass="0.1" pos="0 0 0" diaginertia="0.0005294 0.0005294 0.0001906"/>
      <geom name="coke_body" type="cylinder" size="0.033 0.061" material="coke_mat" friction="3 0.1 0.1"/>
    </body>

    <!--
      Fixed camera looking down at the coke. Resolution 640x480, fovy chosen so
      fx = 554:
          focal_scaling = (1/tan(fovy/2)) * (height/2) = 554
        => fovy = 2*atan(240/554) = 46.8457755 deg
      MuJoCo cameras look along their local -Z; quat computed so the optical
      convention holds in the published image (u = +X right, v = +Y down).
    -->
    <camera name="camera" pos="0.4 0.5 0.625"
      quat="0.091956951 0.035405950 0.357565380 0.928675044"
      fovy="46.8457755" resolution="640 480"/>
  </worldbody>

  <!--
    Home keyframe: arm at initial_positions.yaml, fingers open, coke resting on
    the table. MuJoCo pads a partial keyframe's qpos with ZEROS (not qpos0), so
    the qpos must list every free-joint degree of freedom in order, and ctrl
    must list every actuator in order (the position gripper's ctrl defaults to
    0 = fully closed otherwise).
  -->
  <keyframe>
    <key name="home"
      qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04 0.3 0 0.061 1 0 0 0"
      ctrl="0 -0.785 0 -2.356 0 1.571 0.785 0.04"/>
  </keyframe>
</mujoco>
