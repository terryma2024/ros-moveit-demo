<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
    <xacro:arg name="initial_positions_file"
        default="$(find panda_gazebo_demo)/config/initial_positions.yaml" />
    <xacro:arg name="ros2_control_hardware_type" default="gazebo" />
    <xacro:arg
        name="controllers_file"
        default="$(find panda_gazebo_demo)/config/controllers.yaml" />

    <!-- Import panda urdf file -->
    <xacro:include filename="panda.description.urdf.xacro" />

    <!-- Nominal grasp TCP at the center between the closed fingertips. -->
    <link name="panda_tcp" />

    <joint name="panda_tcp_joint" type="fixed">
        <parent link="panda_hand" />
        <child link="panda_tcp" />
        <origin xyz="0 0 0.1034" rpy="0 0 0" />
    </joint>


    <!-- V5-T004: eye-to-hand 深度相机，固定在 panda_link0 前上方俯视桌面 -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.04 0.08 0.04" />
            </geometry>
            <material name="camera_blue">
                <color rgba="0.1 0.1 0.8 1.0" />
            </material>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="panda_link0" />
        <child link="camera_link" />
        <!-- 相机在底座侧前方 0.4m/Y0.5m、高度 0.625m(相对link0)，避免机械臂挡住视线 -->
        <origin xyz="0.4 0.5 0.625" rpy="0 2.4065 -1.7682" />
    </joint>

    <!-- Fix Panda base to the Gazebo world at the table-top height. -->
    <link name="world" />

    <joint name="world_to_panda" type="fixed">
        <parent link="world" />
        <child link="panda_link0" />
        <origin xyz="0 0 0.775" rpy="0 0 0" />
    </joint>

    <!-- Import panda ros2_control description -->
    <xacro:include filename="panda.ros2_control.xacro" />
    <xacro:include filename="panda_hand.ros2_control.xacro" />

    <xacro:panda_ros2_control name="PandaGazeboSystem"
        initial_positions_file="$(arg initial_positions_file)"
        ros2_control_hardware_type="$(arg ros2_control_hardware_type)" />
    <xacro:panda_hand_ros2_control name="PandaHandGazeboSystem"
        ros2_control_hardware_type="$(arg ros2_control_hardware_type)" />
    <gazebo>
        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_file)</parameters>
        </plugin>
        <!--
            MoveIt's AttachedCollisionObject only changes the planning scene.
            This Gazebo system creates the physical fixed constraint used by
            the simulation pick / place state machine.
        -->
        <plugin
            filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
            <!-- panda_hand is reduced into panda_link7 by URDF-to-SDF fixed-joint lumping. -->
            <parent_link>panda_link7</parent_link>
            <child_model>coke</child_model>
            <child_link>body</child_link>
            <initially_detached>true</initially_detached>
            <attach_topic>/panda/attach_coke</attach_topic>
            <detach_topic>/panda/detach_coke</detach_topic>
            <output_topic>/panda/coke_attached_event</output_topic>
        </plugin>
    </gazebo>

    <!-- V5-T004: Gazebo RGBD 相机 sensor，发布 RGB + Depth + CameraInfo -->
</robot>
