            <uri>model://so101_gazebo_demo_py/meshes/so101/generated/moving/fingertip_pad.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.125 0.5625 1 1</diffuse>
          <ambient>0.125 0.5625 1 1</ambient>
        </material>
      </visual>
    </link>
    <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
      <parameters>@SO101_PACKAGE_SHARE@/config/so101_controllers.yaml</parameters>
    </plugin>
    <plugin name="gz::sim::systems::DetachableJoint" filename="gz-sim-detachable-joint-system">
      <parent_link>gripper</parent_link>
      <child_model>plastic_cup</child_model>
      <child_link>body</child_link>
      <initially_detached>true</initially_detached>
      <attach_topic>/so101/attach_object</attach_topic>
      <detach_topic>/so101/detach_object</detach_topic>
      <output_topic>/so101/object_attached_event</output_topic>
    </plugin>
    <frame name="so101_tcp_joint" attached_to="gripper">
      <pose>0.021399999999999999 0 -0.083948999999999996 0 0 0</pose>
    </frame>
    <frame name="so101_tcp" attached_to="so101_tcp_joint">
      <pose>0 0 0 0 0 0</pose>
    </frame>
  </model>
</sdf>
