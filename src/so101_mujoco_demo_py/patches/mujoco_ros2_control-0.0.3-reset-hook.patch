+class SnapshotCountingPlugin
+  : public mujoco_ros2_control_plugins::MuJoCoROS2ControlPluginBase
+{
+public:
+  bool init(rclcpp::Node::SharedPtr, const mjModel*, mjData*) override { return true; }
+  void update(const mjModel*, mjData*) override { ++update_calls; }
+  void cleanup() override {}
+  void on_pause(bool paused) override
+  {
+    pause_values.push_back(paused);
+  }
+  void on_state_snapshot(const mjModel* model, const mjData* data, bool paused) override
+  {
+    ++snapshot_calls;
+    snapshot_model = model;
+    snapshot_data = data;
+    snapshot_paused = paused;
+    bool competitor_acquired = false;
+    std::thread competitor([this, &competitor_acquired]() {
+      competitor_acquired = mutex->try_lock();
+      if (competitor_acquired)
+      {
+        mutex->unlock();
+      }
+    });
+    competitor.join();
+    snapshot_mutex_was_held = !competitor_acquired;
+  }
+
+  std::recursive_mutex* mutex{ nullptr };
+  int update_calls{ 0 };
+  int snapshot_calls{ 0 };
+  std::vector<bool> pause_values;
+  const mjModel* snapshot_model{ nullptr };
+  const mjData* snapshot_data{ nullptr };
+  bool snapshot_paused{ false };
+  bool snapshot_mutex_was_held{ false };
+};
+
@@ -156,0 +203,87 @@ TEST_F(HeadlessInitTest, HeadlessInitialization)
+TEST_F(HeadlessInitTest, PauseTrueSnapshotUsesAuthoritativeDataUnderMutexWithoutGenericUpdateOrPhysicsWrites)
+{
+#if ROS_DISTRO_HUMBLE
+  ASSERT_EQ(interface_->on_init(hardware_info_), hardware_interface::CallbackReturn::SUCCESS);
+#else
+  hardware_interface::HardwareComponentInterfaceParams params;
+  params.hardware_info = hardware_info_;
+  ASSERT_EQ(interface_->on_init(params), hardware_interface::CallbackReturn::SUCCESS);
+#endif
+  mjModel* model_copy = nullptr;
+  mjData* data_copy = nullptr;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  while ((model_copy == nullptr || data_copy == nullptr) && std::chrono::steady_clock::now() < deadline)
+  {
+    interface_->get_model(model_copy);
+    interface_->get_data(data_copy);
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  mj_deleteData(data_copy);
+  mj_deleteModel(model_copy);
+  mjModel* model = interface_->mj_model_;
+  mjData* data = interface_->mj_data_;
+  ASSERT_NE(model, nullptr);
+  ASSERT_NE(data, nullptr);
+  auto plugin = std::make_shared<SnapshotCountingPlugin>();
+  plugin->mutex = interface_->sim_mutex_;
+  interface_->plugin_instances_ = { plugin };
+  const std::vector<mjtNum> qpos(data->qpos, data->qpos + model->nq);
+  const std::vector<mjtNum> qvel(data->qvel, data->qvel + model->nv);
+  const std::vector<mjtNum> ctrl(data->ctrl, data->ctrl + model->nu);
+  const std::vector<mjtNum> xfrc(data->xfrc_applied, data->xfrc_applied + 6 * model->nbody);
+
+  auto request = std::make_shared<mujoco_ros2_control_msgs::srv::SetPause::Request>();
+  request->paused = true;
+  auto response = std::make_shared<mujoco_ros2_control_msgs::srv::SetPause::Response>();
+  interface_->set_pause_callback(request, response);
+  ASSERT_TRUE(response->success);
+  EXPECT_EQ(plugin->pause_values, std::vector<bool>({ true }));
+  EXPECT_EQ(plugin->snapshot_calls, 1);
+  EXPECT_EQ(plugin->update_calls, 0);
+  EXPECT_EQ(plugin->snapshot_model, model);
+  EXPECT_EQ(plugin->snapshot_data, data);
+  EXPECT_TRUE(plugin->snapshot_paused);
+  EXPECT_TRUE(plugin->snapshot_mutex_was_held);
+  EXPECT_EQ(std::vector<mjtNum>(data->qpos, data->qpos + model->nq), qpos);
+  EXPECT_EQ(std::vector<mjtNum>(data->qvel, data->qvel + model->nv), qvel);
+  EXPECT_EQ(std::vector<mjtNum>(data->ctrl, data->ctrl + model->nu), ctrl);
+  EXPECT_EQ(std::vector<mjtNum>(data->xfrc_applied, data->xfrc_applied + 6 * model->nbody), xfrc);
+
+  interface_->set_pause_callback(request, response);
+  ASSERT_TRUE(response->success);
+  EXPECT_EQ(plugin->pause_values, std::vector<bool>({ true, true }));
+  EXPECT_EQ(plugin->snapshot_calls, 2) << "idempotent pause true must emit exactly one new snapshot";
+  EXPECT_EQ(plugin->update_calls, 0);
+
+  request->paused = false;
+  interface_->set_pause_callback(request, response);
+  ASSERT_TRUE(response->success);
+  EXPECT_EQ(plugin->pause_values, std::vector<bool>({ true, true, false }));
+  EXPECT_EQ(plugin->snapshot_calls, 2) << "pause false must not emit a state snapshot";
+}
+
+TEST_F(HeadlessInitTest, PauseFailureWithMissingAuthoritativeDataCallsNoPluginHooks)
+{
+#if ROS_DISTRO_HUMBLE
+  ASSERT_EQ(interface_->on_init(hardware_info_), hardware_interface::CallbackReturn::SUCCESS);
+#else
+  hardware_interface::HardwareComponentInterfaceParams params;
+  params.hardware_info = hardware_info_;
+  ASSERT_EQ(interface_->on_init(params), hardware_interface::CallbackReturn::SUCCESS);
+#endif
+  auto plugin = std::make_shared<SnapshotCountingPlugin>();
+  plugin->mutex = interface_->sim_mutex_;
+  interface_->plugin_instances_ = { plugin };
+  mjData* authoritative_data = interface_->mj_data_;
+  interface_->mj_data_ = nullptr;
+  auto request = std::make_shared<mujoco_ros2_control_msgs::srv::SetPause::Request>();
+  request->paused = true;
+  auto response = std::make_shared<mujoco_ros2_control_msgs::srv::SetPause::Response>();
+  interface_->set_pause_callback(request, response);
+  interface_->mj_data_ = authoritative_data;
+  EXPECT_FALSE(response->success);
+  EXPECT_TRUE(plugin->pause_values.empty());
+  EXPECT_EQ(plugin->snapshot_calls, 0);
+  EXPECT_EQ(plugin->update_calls, 0);
+}
