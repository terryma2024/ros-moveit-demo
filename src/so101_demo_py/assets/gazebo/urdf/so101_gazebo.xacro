<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ROS 2 Control -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find so101_demo_py)/config/so101_controllers.yaml</parameters>
        </plugin>

        <!--
          This must name a link entity that survives URDF-to-SDF conversion.
          The running Gazebo scene graph exposes gripper directly under so101.
          The output is an edge-triggered event; a later relay owns durable state.
        -->
        <plugin
            filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
            <parent_link>gripper</parent_link>
            <child_model>plastic_cup</child_model>
            <child_link>body</child_link>
            <initially_detached>true</initially_detached>
            <attach_topic>/so101/attach_object</attach_topic>
            <detach_topic>/so101/detach_object</detach_topic>
            <output_topic>/so101/object_attached_event</output_topic>
        </plugin>

    </gazebo>

</robot>
