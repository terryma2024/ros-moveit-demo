{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "qualification_run_id",
    "worker_count",
    "scene_manifest",
    "functional_manifest",
    "formal_split_manifest",
    "controlled_identity",
    "quality_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "ACT_PARALLEL_COLLECTION_GATE"
    },
    "qualification_run_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_count": {
      "type": "integer",
      "const": 8
    },
    "scene_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "functional_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "formal_split_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "controlled_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "runtime_config_sha256",
        "collection_config_sha256",
        "contact_policy_fingerprint",
        "image_source_install",
        "gpu_uuid"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "collection_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contact_policy_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_source_install": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inference",
            "shard"
          ],
          "properties": {
            "inference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "digest",
                "package_source_sha256",
                "install_sha256"
              ],
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "package_source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "install_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "shard": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "digest",
                "package_source_sha256",
                "install_sha256"
              ],
              "properties": {
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "package_source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "install_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "gpu_uuid": {
          "type": "string",
          "pattern": "^GPU-[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "quality_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorder_lossless",
        "frame_continuity",
        "qc_valid_rate",
        "teacher_physical_success_rate"
      ],
      "properties": {
        "recorder_lossless": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^\\u0000]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "frame_continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^\\u0000]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "qc_valid_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^\\u0000]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "teacher_physical_success_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^\\u0000]*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
