 }  // namespace
 namespace mujoco_ros2_control
 {
+#ifdef __APPLE__
+namespace
+{
+std::mutex macos_ui_mutex;
+std::condition_variable macos_ui_cv;
+std::function<void()> macos_ui_task;
+std::function<void()> macos_ui_stop;
+bool macos_ui_decided = false;
+bool macos_ui_shutdown_requested = false;
+}  // namespace
+
+void submit_macos_ui_task(std::function<void()> task, std::function<void()> stop)
+{
+  {
+    std::lock_guard<std::mutex> lock(macos_ui_mutex);
+    macos_ui_task = std::move(task);
+    macos_ui_stop = std::move(stop);
+    macos_ui_shutdown_requested = false;
+    macos_ui_decided = true;
+  }
+  macos_ui_cv.notify_all();
+}
+
+void notify_macos_ui_not_required()
+{
+  {
+    std::lock_guard<std::mutex> lock(macos_ui_mutex);
+    macos_ui_decided = true;
+  }
+  macos_ui_cv.notify_all();
+}
+
+bool run_macos_ui_task_on_main_thread()
+{
+  std::function<void()> task;
+  {
+    std::unique_lock<std::mutex> lock(macos_ui_mutex);
+    macos_ui_cv.wait(lock, []() { return macos_ui_decided || macos_ui_shutdown_requested; });
+    task = std::move(macos_ui_task);
+    macos_ui_decided = false;
+  }
+  if (!task)
+  {
+    return false;
+  }
+  task();
+  {
+    std::lock_guard<std::mutex> lock(macos_ui_mutex);
+    macos_ui_stop = {};
+  }
+  return true;
+}
+
+void request_macos_ui_stop()
+{
+  std::function<void()> stop;
+  {
+    std::lock_guard<std::mutex> lock(macos_ui_mutex);
+    macos_ui_shutdown_requested = true;
+    stop = macos_ui_stop;
+  }
+  if (stop)
+  {
+    stop();
+  }
+  macos_ui_cv.notify_all();
+}
+#endif
+
