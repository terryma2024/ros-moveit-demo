diff --git a/mujoco_ros2_control/src/mujoco_system_interface.cpp b/mujoco_ros2_control/src/mujoco_system_interface.cpp
index cb1e749..33797c5 100644
--- a/mujoco_ros2_control/src/mujoco_system_interface.cpp
