+#ifdef __APPLE__
+TEST(AppleMainThreadUi, RunsSubmittedUiTaskOnCallingThread)
+{
+  const auto main_thread = std::this_thread::get_id();
+  std::thread::id task_thread;
+  std::thread submitter([&task_thread]() {
+    mujoco_ros2_control::submit_macos_ui_task(
+        [&task_thread]() { task_thread = std::this_thread::get_id(); }, []() {});
+  });
+  submitter.join();
+
+  EXPECT_TRUE(mujoco_ros2_control::run_macos_ui_task_on_main_thread());
+  EXPECT_EQ(task_thread, main_thread);
+}
+#endif
