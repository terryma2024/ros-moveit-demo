From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "zjumty@aliyun.com" <zjumty@aliyun.com>
Date: Fri, 14 Aug 2026 16:33:38 +0800
Subject: [PATCH 09/11] Apple conversion warnings


diff --git a/mujoco_ros2_control/CMakeLists.txt b/mujoco_ros2_control/CMakeLists.txt
index 57a5bc1..bd9dd99 100644
--- a/mujoco_ros2_control/CMakeLists.txt
+++ b/mujoco_ros2_control/CMakeLists.txt
@@ -171,6 +171,11 @@ add_library(mujoco_ros2_control SHARED
     src/mujoco_lidar.cpp
     src/viewer_camera.cpp
 )
+if(APPLE)
+  target_compile_options(mujoco_ros2_control PRIVATE
+    -Wno-error=sign-conversion
+    -Wno-error=float-conversion)
+endif()
 # Ensure MuJoCo library can be found at runtime regardless of how it was installed above.
 # mujoco_vendor installs libmujoco.so under opt/mujoco_vendor/lib/ relative to the
 # install prefix, so that directory must be in the RPATH alongside the standard lib/.
