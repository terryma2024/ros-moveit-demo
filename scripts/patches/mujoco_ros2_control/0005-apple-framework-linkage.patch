From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "zjumty@aliyun.com" <zjumty@aliyun.com>
Date: Fri, 14 Aug 2026 16:33:38 +0800
Subject: [PATCH 05/11] Apple framework linkage


diff --git a/mujoco_ros2_control/CMakeLists.txt b/mujoco_ros2_control/CMakeLists.txt
index 5ad75e9..00a13b5 100644
--- a/mujoco_ros2_control/CMakeLists.txt
+++ b/mujoco_ros2_control/CMakeLists.txt
@@ -104,7 +104,12 @@ if(mujoco_simulate_lib AND NOT EXISTS "${MUJOCO_SIMULATE_DIR}/simulate.cc")
     IMPORTED_LOCATION "${mujoco_simulate_lib}"
   )
   target_include_directories(mujoco_simulate INTERFACE ${MUJOCO_SIMULATE_DIR} ${MUJOCO_INCLUDE_DIR})
-  target_link_libraries(mujoco_simulate INTERFACE ${MUJOCO_LIB} glfw)
+  if(APPLE)
+    target_link_libraries(mujoco_simulate INTERFACE
+      ${MUJOCO_LIB} glfw "-framework Cocoa" "-framework CoreVideo")
+  else()
+    target_link_libraries(mujoco_simulate INTERFACE ${MUJOCO_LIB} glfw)
+  endif()
 else()
   message(STATUS "No linkable simulate application available, compiling from source")
   add_library(platform_ui_adapter OBJECT)
