# Host values for the Host gate and the evidence and image tools on ai-station.
# Plain KEY=VALUE lines. A value may refer to keys defined above it. The loader (load_host.zsh)
# never overrides a variable that is already set in the environment. Keep the key set identical
# in every hosts/*.env file; scripts/tests/test_gate_tools.py enforces it.
HOST_NAMES="ai-station"
W=/data/work
EVIDENCE_ROOT=${W}/so101-evidence/act-data/20260924-fbc25063-resume
EVIDENCE_R=${EVIDENCE_ROOT}/container-campaign-20261012T003700Z-2130aaf1
SCRATCH_ROOT=${EVIDENCE_R}/scratch
BUILD_ROOT=${W}/so101-build
GATE_CCACHE_DIR=${BUILD_ROOT}/ccache
DEPS_FREEZE=${W}/so101-tools/deps/nonhead-installed-freeze
TEST_VENV=${W}/venvs/so101-act-test
DEMO_PYTHON=${W}/venvs/so101-grounded-sam/bin/python
DISK_PATH=/data
DEMO_WORKERS=16
GATE_STAGED=0
GATE_SCOPE=0
GATE_SCOPE_MEMORY_HIGH=
GATE_SCOPE_MEMORY_MAX=
GATE_MEM_SAMPLER=0
GATE_RESET_SIGINT=0
DEMO_DIST=
DEMO_MALLOC_ARENA_MAX=
DEMO_MALLOC_TRIM_THRESHOLD=
DEMO_MALLOC_MMAP_THRESHOLD=
GATE_EXTRA_PYTHONPATH=
NATIVE_BUILD_DEPS=${W}/so101-tools/images/native-build-dependencies
BUN_BIN=/home/matianyi/.nvm/versions/node/v26.9.0/bin/bun
BUN_CACHE=/home/matianyi/.bun/install/cache
GATE_UPSTREAM_PARALLEL=0
GATE_UPSTREAM_CPU_SHARE=0.33
# Proxy for the networked image-build steps (shard-deps, mount-base): docker build --network host with the predefined proxy build
# arguments. Leave both unset to build without it.
BUILD_PROXY=http://127.0.0.1:10809
BUILD_NO_PROXY=localhost,127.0.0.1,mirrors.tuna.tsinghua.edu.cn,pypi.tuna.tsinghua.edu.cn,registry.npmmirror.com
