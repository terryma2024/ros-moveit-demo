# Host values for the Host gate on antzb (hostname AI-STATION-001). Same key set as ai-station.env.
# Evidence, build and ccache locations are the ones antzb has used so far (gate-env of the
# act-train-profile run); change them here when the gate gets a permanent home on this host.
# Image builds are not run on antzb, so the image keys are empty.
HOST_NAMES="ai-station-001 antzb"
W=/data/work
EVIDENCE_ROOT=${W}/so101-evidence/act-train-profile/20261019-nsys-3a7c/gate-env/evidence
EVIDENCE_R=${EVIDENCE_ROOT}
SCRATCH_ROOT=${EVIDENCE_R}/scratch
BUILD_ROOT=${W}/so101-evidence/act-train-profile/20261019-nsys-3a7c/gate-env/so101-build
GATE_CCACHE_DIR=${BUILD_ROOT}/ccache
DEPS_FREEZE=${W}/so101-tools/deps/nonhead-installed-freeze
TEST_VENV=${W}/venvs/so101-act-test
DEMO_PYTHON=${W}/venvs/so101-grounded-sam/bin/python
DISK_PATH=/data
DEMO_WORKERS=8
GATE_STAGED=1
GATE_SCOPE=1
GATE_SCOPE_MEMORY_HIGH=26G
GATE_SCOPE_MEMORY_MAX=29G
GATE_MEM_SAMPLER=1
GATE_RESET_SIGINT=1
DEMO_DIST=worksteal
DEMO_MALLOC_ARENA_MAX=2
DEMO_MALLOC_TRIM_THRESHOLD=131072
DEMO_MALLOC_MMAP_THRESHOLD=131072
GATE_EXTRA_PYTHONPATH=
NATIVE_BUILD_DEPS=
BUN_BIN=
BUN_CACHE=
