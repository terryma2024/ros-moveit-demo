from pathlib import Path
import json, os, subprocess, sys, time
C = Path(__file__).parent
name = sys.argv[1]
out = C / 'checks' / name
out.mkdir(exist_ok=False)
scratch = C / 'scratch' / name / 'tmp'
scratch.mkdir(parents=True, exist_ok=False)
env = dict(os.environ, **json.loads((C / 'gate-environment-fixture001.json').read_text()))
env.update(TMPDIR=str(scratch), TMP=str(scratch), TEMP=str(scratch),
           PYTEST_DISABLE_PLUGIN_AUTOLOAD='1', PYTEST_ADDOPTS='')
env['PYTHONPATH'] = str(C) + ':/data/work/venvs/so101-v5-t004-perception/lib/python3.12/site-packages:' + env['PYTHONPATH']
if '--legacy' in sys.argv:
    env['SO101_NOMINAL_LEGACY_BASELINE'] = '1'
else:
    env.pop('SO101_NOMINAL_LEGACY_BASELINE', None)
P = '/usr/bin/python3'
assert os.access(P, os.X_OK)
(out / 'temp-proof.txt').write_text(subprocess.check_output([P, '-c',
    'import os,sys,tempfile,pytest,xdist;assert tempfile.gettempdir()==os.environ["TMPDIR"];print(sys.executable,pytest.__version__,xdist.__version__,tempfile.gettempdir())'], env=env, text=True))
workers = min(8, os.cpu_count() or 1)
argv = [P, '-m', 'pytest', str(C / 'test_nominal_contract.py'), '-p', 'xdist.plugin',
        '-n', str(workers), '--junitxml=' + str(out / 'junit.xml')]
started = time.monotonic()
with (out / 'stdout.log').open('xb') as f:
    result = subprocess.run(argv, env=env, stdout=f, stderr=subprocess.STDOUT, timeout=60)
receipt = dict(rc=result.returncode, elapsed_s=time.monotonic()-started,
               argv=argv, scratch=str(scratch), logical_cpus=os.cpu_count(), workers=workers,
               scope='Complete new task-owned nominal contract test module',
               legacy_test_adapter='--legacy' in sys.argv, runtime_evidence=False)
(out / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
print(json.dumps(receipt))
print((out / 'stdout.log').read_text()[-3000:])
raise SystemExit(result.returncode)
