 (G/'scope-preflight.stdout').write_text(q.stdout);(G/'scope-preflight.stderr').write_text(q.stderr)
 assert q.returncode==0,q.stderr
 result=json.loads(q.stdout);assert result['optional_observers_off'] is True
 return result
