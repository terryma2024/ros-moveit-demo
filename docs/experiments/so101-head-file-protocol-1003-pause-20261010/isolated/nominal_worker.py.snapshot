if map_ok:
 map_ok=bool(native_child.get('executable')==role_expected['node']['executable'] and all(native_child.get('owner',{}).get(k)==role_expected['node']['identity'][k]for k in ('pid','start_ticks','uid')))
write(G/'process-maps.json',dict(proofs=role_maps,expected=role_expected,native_child=native_child,verified=map_ok))
