assert inputs['stop_declaration']['teardown_timeout_s']==1. and graph(env,G/'launch-preflight-graph.json')
scratch=D/'scratch/nominal-holds001'/checkpoint/'tmp';scratch.mkdir(parents=True,exist_ok=False);env.update(TMPDIR=str(scratch),TMP=str(scratch),TEMP=str(scratch))
for i,exe in enumerate((P,'/usr/bin/python3')):
 assert os.access(exe,os.X_OK)
 q=subprocess.run([exe,'-c','import tempfile,os;assert tempfile.gettempdir()==os.environ["TMPDIR"];print(tempfile.gettempdir())'],env=env,text=True,capture_output=True,check=True);(G/f'scratch-proof-{i}.txt').write_text(q.stdout)
assert not (G/'holding-started.json').exists() and not (G/'output').exists()
command=[P,str(G/'head_neck_timing_probe.py'),'--execution-inputs',str(G/'inputs.json'),'--duration-s','120','--output',str(G/'output')]
write(G/'command.json',dict(argv=command,scratch=str(scratch),normal_cancel=240,total=300))
started=time.monotonic();write(G/'holding-started.json',dict(monotonic_ns=time.monotonic_ns(),wall_ns=time.time_ns(),count=1))
tracked={};maps={};role_maps={};role_expected={};verified_map_roles=set();cancel_sent=False;fallback=False;owner_killed=False;last_snapshot=0.
with(G/'stdout.log').open('w')as out,(G/'stderr.log').open('w')as err:
 owner=subprocess.Popen(command,env=env,cwd=D,stdout=out,stderr=err,start_new_session=True)
 owner_identity=process(owner.pid);write(G/'owner.json',owner_identity)
 role_expected['owner']=dict(identity=owner_identity,executable=str(Path(P).resolve()),session=inputs['run']['session_id'],libraries=[file_ref(R/'install/so101_mujoco_support/lib/libso101_head_revocation_transport.so')])
 node_exe=D/'install/mujoco_ros2_control/lib/mujoco_ros2_control/ros2_control_node'
 node_libraries=[file_ref(p)for p in (D/'install/mujoco_ros2_control/lib/libmujoco_ros2_control.so',D/'install/mujoco_ros2_control/lib/libmujoco_clock_trace.so',R/'install/so101_mujoco_support/lib/libso101_broker_owned_trajectory_controller.so',D/'install/mujoco_ros2_control/lib/libso101_exit_phase.so',D/'install/controller_manager/lib/libcontroller_manager.so')]
 def observed_environment(identity,role):
  raw=Path('/proc',str(identity['pid']),'environ').read_bytes()
  observed={v.split(b'=',1)[0].decode(errors='strict'):v.split(b'=',1)[1].decode(errors='strict')for v in raw.split(b'\0')if b'='in v}
  require_observers_off(observed)
  assert observed['SO101_SIMULATION_SESSION_ID']==inputs['run']['session_id']
  write(G/(role+'-environment-proof.json'),dict(identity=identity,optional_observers_off=True,environment_keys=sorted(observed)))
 observed_environment(owner_identity,'owner')
 def collect_role(role):
  expected=role_expected[role]
  if role in verified_map_roles:return
  try:
   proof=map_snapshot(expected['identity']['pid'],expected['identity'],expected['executable'],expected['session'],expected['libraries'])
   if proof is not None:
    role_maps[role]=proof
    if role_valid(proof,expected):verified_map_roles.add(role)
  except (FileNotFoundError,ProcessLookupError):return
  except PermissionError:
   try:row=process(expected['identity']['pid'])
   except (FileNotFoundError,ProcessLookupError):return
   if row['state']=='Z'and all(row[k]==expected['identity'][k]for k in ('pid','start_ticks','uid')):return
   raise
 while owner.poll() is None:
  elapsed=time.monotonic()-started
  collect_role('owner')
  # Discover only descendants of this exact owner; retain immutable pid/start identity.
  pending=[owner.pid]
  while pending:
   pid=pending.pop()
   try:children=[int(s)for s in Path('/proc',str(pid),'task',str(pid),'children').read_text().split()]
   except FileNotFoundError:continue
   for child in children:
    record=None
    try:
     record=scoped_child(child,tracked.get(str(child)),inputs['run']['session_id'])
     if record is None:continue
     record['group_owned']=os.getpgid(child)==child
     tracked.setdefault(str(child),record);pending.append(child)
     if record['state']=='Z':continue
     if record['argv'].split()and record['argv'].split()[0]==str(node_exe):
      expected=dict(identity=record,executable=str(node_exe),session=inputs['run']['session_id'],libraries=node_libraries)
      if 'node'in role_expected and any(role_expected['node']['identity'][k]!=record[k]for k in ('pid','start_ticks','uid')):raise ValueError('MAP_NATIVE_NODE_CHANGED')
      if 'node'not in role_expected:role_expected['node']=expected;observed_environment(record,'node')
      collect_role('node')
      if 'node'in role_maps:maps[str(child)]=dict(identity=record,maps=role_maps['node']['maps'])
    except (FileNotFoundError,ProcessLookupError):continue
    except PermissionError:
     try:retired=process(child)
     except (FileNotFoundError,ProcessLookupError):continue
     if retired['state']=='Z' and (record is None or retired['start_ticks']==record['start_ticks']):continue
     raise
  if elapsed-last_snapshot>=1.:
   if tracked:write(G/'owned-children.json',tracked)
   if maps:write(G/'actual-maps.json',maps)
   if role_maps:write(G/'process-maps.json',dict(proofs=role_maps,expected=role_expected))
   last_snapshot=elapsed
  if elapsed>=240 and not cancel_sent:
   assert same_process(owner_identity);owner.send_signal(signal.SIGTERM);cancel_sent=True
  # Original helper must retire within15s after cancellation. If it cannot, retain INVALID
  # and mirror its exact owned-group SIGINT / one-second SIGKILL fallback; never claim Stop proof.
  if elapsed>=255 and not fallback:
   fallback=True;write(G/'cleanup-budget-exceeded.json',dict(elapsed_s=elapsed,status='INVALID'))
   for row in tracked.values():
    if row['group_owned'] and same_process(row) and os.getpgid(row['pid'])==row['pid']:os.killpg(row['pid'],signal.SIGINT)
  if elapsed>=256 and fallback:
   for row in tracked.values():
    if row['group_owned'] and same_process(row) and os.getpgid(row['pid'])==row['pid']:os.killpg(row['pid'],signal.SIGKILL)
  if elapsed>=285 and not owner_killed:
   assert same_process(owner_identity);owner.kill();owner_killed=True
  if elapsed>=290:break
  time.sleep(.05)
 rc=owner.poll()
 if rc is None:rc=owner.wait(timeout=1)
exit_elapsed=time.monotonic()-started
post=graph(env,G/'postflight-graph.json',timeout=min(15,max(1,300-exit_elapsed)))
absence={pid:not same_process(row)for pid,row in tracked.items()};write(G/'independent-os-readback.json',dict(owner_absent=not same_process(owner_identity),children_absent=absence))
