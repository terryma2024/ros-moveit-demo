native_error=None;native_result=None
try:
 receipts=(report or{}).get('receipts',{})
 assert not same_process(owner_identity) and all(absence.values())
 native_result=read_all(G/'output/controller-records',receipts.get('hold_started_ns'),receipts.get('hold_ended_ns'))
except Exception as e:native_error=dict(type=type(e).__name__,message=str(e))
write(G/'native-readback.json',dict(result=native_result,error=native_error))
