(G/'strict-startup.stdout').write_text(q.stdout);(G/'strict-startup.stderr').write_text(q.stderr);strict=q.returncode==0 and json.loads(q.stdout)['strict']
problem=report.get('problem')if report else None
held=bool(report and report['receipts'].get('hold_ended_ns',0)-report['receipts'].get('hold_started_ns',0)>=120_000_000_000)
cleanup=bool(report and 0<report['receipts'].get('retirement_ended_ns',0)-report['receipts'].get('retirement_started_ns',0)<15_000_000_000)
children=(report or{}).get('receipts',{}).get('children',[])
child_ids={row['pid']for row in children}
all_child_rc0=len(children)==3 and len(child_ids)==3 and all(type(row.get('rc'))is int and row['rc']==0 for row in children) and child_ids.issubset({int(pid)for pid in tracked})
result=dict(schema='NOMINAL_WORKER_001',status='PROVISIONAL_PASS',rc=rc,elapsed_s=time.monotonic()-started,report=report,strict_startup_stop_close=strict,maps_verified=map_ok,holding_complete=held,cleanup_within15=cleanup,postflight_empty=post,owner_absent=not same_process(owner_identity),children_absent=bool(tracked)and all(absence.values()),seal_verified=bool(report and report['receipts'].get('seal_verified')),all_child_rc0=all_child_rc0,native_all_valid=native_error is None and native_result is not None,cancel_sent=cancel_sent,fallback_used=fallback or owner_killed,original_timing_qualified=bool(report and report['qualified']),original_problem=problem,production_qualified=False,live20_allowed=False,fresh40_allowed=False)
valid=worker_valid(result)
if not valid:result['status']='FAIL'
write(G/'receipt.json',result);print(json.dumps(result),flush=True);raise SystemExit(0 if valid else 1)
