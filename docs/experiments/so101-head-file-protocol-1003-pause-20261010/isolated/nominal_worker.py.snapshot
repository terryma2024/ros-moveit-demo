def sha(p):
 h=hashlib.sha256()
 with Path(p).open('rb') as f:
  for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
 return h.hexdigest()
def write(p,v):
 with Path(p).open('w')as f:json.dump(v,f,indent=2,allow_nan=False);f.write('\n');f.flush();os.fsync(f.fileno())
def check_ref(row):assert sha(row['path'])==row['sha256'],row['path']
def graph(env,destination,timeout=15):
 try:
  q=subprocess.run(['/opt/ros/jazzy/bin/ros2','node','list','--no-daemon'],env=env,text=True,capture_output=True,timeout=timeout)
 except subprocess.TimeoutExpired as e:
  write(destination,dict(rc=None,status='INVALID_GRAPH_TIMEOUT',stdout=str(e.stdout),stderr=str(e.stderr),timeout_s=timeout));return False
 write(destination,dict(rc=q.returncode,stdout=q.stdout,stderr=q.stderr));return q.returncode==0 and not q.stdout.strip()
